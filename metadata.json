{
  "name": "xDeepSeek Token Badge",
  "name_de": "xDeepSeek Token-Anzeige",
  "version": "1.0.6",
  "description": "Shows the current context window usage (tokens) as a floating badge in the DeepSeek web chat.",
  "description_de": "Zeigt den aktuellen Kontext-Füllstand (Token) als schwebendes Badge im DeepSeek-Chat an.",
  "author": "immerzu",
  "author_url": "https://greasyfork.org/de/users/1629833-immerzu",
  "namespace": "https://greasyfork.org/de/users/1629833-immerzu",
  "license": "MIT",
  "match": [
    "https://chat.deepseek.com/*"
  ],
  "grant": "none",
  "run_at": "document-start",
  "no_frames": true,
  "icon": "https://www.google.com/s2/favicons?sz=64&domain=deepseek.com",
  "tags": [
    "deepseek",
    "token",
    "context",
    "badge",
    "chat",
    "kontext",
    "tokenzaehler",
    "token-counter"
  ],
  "language": "de",
  "script_type": "public",
  "context_window_size_source": "model_configs[].file_feature.token_limit / token_limit_with_thinking (scope=model), sonst normal_history_and_file_token_limit (scope=main)",
  "context_window_size_fallback": 890880,
  "display_format": "📊 192K / 891K  (22 %) — dreistellig gerundet, exakte Werte im Tooltip",
  "session_token_value": "Maximum der accumulated_token_usage-Werte der Chat-History",
  "hook_targets": [
    "XMLHttpRequest.prototype.open",
    "XMLHttpRequest.prototype.send",
    "XMLHttpRequest.prototype.setRequestHeader",
    "window.fetch"
  ],
  "refresh_after_answer": "Am Ende des Antwort-Streams /api/v0/chat/completion wird die History ohne Cache-Parameter nachgeladen (1,5 s danach, ggf. erneut nach 3 s), weil die App nach dem Senden keine history_messages-Abfrage ausführt und der SSE-Stream nur accumulated_token_usage:0 liefert.",
  "primary_hook": "XMLHttpRequest.prototype.send",
  "history_cache_handling": "Bei cache_control=MERGE (0 Nachrichten) wird /chat/history_messages einmalig ohne cache_version/cache_reset_at nachgeladen (REPLACE-Antwort mit vollem Tokenstand).",
  "api_endpoint_fragment": "/chat/history_messages",
  "extracted_field": "data.biz_data.chat_messages[].accumulated_token_usage",
  "session_store": "localStorage xdsTokenBadge.sessionTokens (letzter Wert je Chat)",
  "repository_note": "Zur Veröffentlichung vorbereitet am 2026-09-10",
  "greasyfork_publish_url": "https://greasyfork.org/de/script_versions/new",
  "files": [
    {
      "path": "xdeepseek-token-badge.user.js",
      "purpose": "Das veröffentlichungsfertige Userscript"
    },
    {
      "path": "README.md",
      "purpose": "Projektübersicht und technische Dokumentation"
    },
    {
      "path": "PUBLISHING.md",
      "purpose": "Schritt-für-Schritt-Anleitung zur GreasyFork-Veröffentlichung"
    },
    {
      "path": "DESCRIPTION.greasyfork.md",
      "purpose": "Fertige Listing-Beschreibung für GreasyFork"
    },
    {
      "path": "INSTALL.md",
      "purpose": "Endnutzer-Installationsanleitung"
    },
    {
      "path": "CHANGELOG.md",
      "purpose": "Versionshistorie und Entwicklungsnotizen"
    },
    {
      "path": "LICENSE",
      "purpose": "MIT-Lizenztext"
    }
  ]
}
